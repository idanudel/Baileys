# HTTP port the bridge listens on
PORT=7070

# Directory where WhatsApp session credentials are persisted (gitignored via baileys_auth_info* pattern)
AUTH_DIR=./baileys_auth_info

# SQLite file storing runtime config (API key, webhook URLs) and activity history
DB_PATH=./bridge.db

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# First-boot only: seed the API key / webhook URLs into the database if it's empty.
# After the first run, use /settings to change these - this file is no longer read.
API_KEY=change-me
WEBHOOK_URLS=

# Optional: Pushover keys for deploy success/failure notifications (read by
# .github/workflows/deploy.yml, not by the app itself). Reuse the same values
# already used by other projects on this Pi - don't request new ones.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
