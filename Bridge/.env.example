# HTTP port the bridge listens on
PORT=7070

# Shared secret required on every request (header: x-api-key, or ?key= for GET /qr)
API_KEY=change-me

# Comma-separated list of URLs to POST incoming WhatsApp events to
WEBHOOK_URLS=

# Directory where WhatsApp session credentials are persisted (gitignored via baileys_auth_info* pattern)
AUTH_DIR=./baileys_auth_info

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Optional: Pushover keys for deploy success/failure notifications (read by
# .github/workflows/deploy.yml, not by the app itself). Reuse the same values
# already used by other projects on this Pi - don't request new ones.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
