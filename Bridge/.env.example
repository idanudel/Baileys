# HTTP port the bridge listens on
PORT=7070

# Directory where WhatsApp session credentials are persisted (gitignored via baileys_auth_info* pattern)
AUTH_DIR=./baileys_auth_info

# SQLite file storing runtime config (API key, webhook URLs) and activity history
DB_PATH=./bridge.db

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# First-boot only: seed the API key / webhook URLs into the database if it's empty.
# After the first run, use /admin to change these - this file is no longer read.
API_KEY=change-me
WEBHOOK_URLS=
